#!/bin/sh
set -eu

case "${1:-}" in
  run|status|publish|restore) ;;
  *) echo "usage: nyc-rentmap run|status|publish|restore" >&2; exit 2 ;;
esac

ROOT=/srv/nyc-rentmap
CMD=$1
set --
if [ -d "$ROOT/backup" ]; then
  set -- -e NYC_RENTMAP_BACKUP_DIR="$ROOT/backup" \
    -v "$ROOT/backup:$ROOT/backup" \
    -v "$ROOT/secrets/backup_key:$ROOT/secrets/backup_key:ro"
fi
if [ -f "$ROOT/site.env" ]; then
  set -- "$@" --env-file "$ROOT/site.env"
fi
exec /usr/bin/docker run --rm --name "nyc-rentmap-$CMD" \
  --read-only --tmpfs /tmp \
  --cap-drop ALL --security-opt no-new-privileges \
  --env-file "$ROOT/secrets/rentcast.env" \
  -e NYC_RENTMAP_DATA_DIR="$ROOT/data" \
  -v "$ROOT/repo:$ROOT/repo" \
  -v "$ROOT/data:$ROOT/data" \
  -v "$ROOT/secrets/deploy_key:$ROOT/secrets/deploy_key:ro" \
  -v "$ROOT/secrets/known_hosts:$ROOT/secrets/known_hosts:ro" \
  "$@" \
  nyc-rentmap:latest "$CMD"
